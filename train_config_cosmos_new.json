        "p_mean": 1.3862943611198906,
        "p_std": 1.2,
        "sigma_max": 200,
        "sigma_min": 0.01,
        "uniform_lower": 1.0,
        "uniform_upper": 85.0
      },
      "adjust_video_noise": true,
      "resize_online": true,
      "resolution": "224",
      "high_sigma_strategy": "none"
